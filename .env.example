# ==========================================
# LINE 群組關鍵字助手 環境變數設定範本
# 請複製此檔案為 .env 並填入實際參數
# ==========================================

# 1. 資料庫連線設定 (Render PostgreSQL 或本機資料庫)
# 本機開發若未啟動 PostgreSQL，也可暫時設為 sqlite:///./linebot.db
DATABASE_URL=postgresql://user:password@localhost:5432/line_keyword_bot

# 2. LINE Messaging API 設定 (於 LINE Developers Console 取得)
LINE_CHANNEL_SECRET=your_line_channel_secret
LINE_CHANNEL_ACCESS_TOKEN=your_line_channel_access_token

# 3. Cloudinary 媒體代管設定 (可擇一設定 CLOUDINARY_URL 或分別設定三項參數)
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_FOLDER=line_keyword_bot

# 4. 後台管理員帳號密碼與 JWT 金鑰
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme123
JWT_SECRET_KEY=replace_with_a_strong_random_secret_key
JWT_EXPIRE_MINUTES=1440
